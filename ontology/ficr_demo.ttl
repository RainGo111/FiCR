@prefix : <https://lbd.example.com/instances/Duplex_A_20110907_ficr#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix lbd: <https://lbd.example.com/> .
@prefix ns1: <http://www.w3.org/2006/vcard/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ficr: <https://w3id.org/bam/ficr#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://lbd.example.com/instances/Duplex_A_20110907_ficr#> .

<https://lbd.example.com/instances/Duplex_A_20110907_ficr> rdf:type owl:Ontology ;
                                                            rdfs:comment "FiCR ABox — converted from LBD/IFC. Import ficr_tbox.ttl for full reasoning."@en ,
                                                                         "FiCR, Fire Compliance and Risk Analysis Ontology"@en ,
                                                                         "FiCR, Fire Compliance and Risk Analysis, is a domain specific semantic model designed to represent fire safety and fire risk relevant physical objects, building elements, equipment, functional roles, and their relationships in existing buildings. It supports a structured and interoperable representation of both passive and active fire protection measures, as well as risk related attributes and performance outcomes, enabling compliance assessment, fire risk analysis, and inspection activities throughout the building operation and maintenance phase. FiCR further provides a semantic foundation for rule based reasoning and fire oriented digital twins that integrate regulatory compliance and risk informed decision making."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/06/sw-vocab-status/ns#term_status
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2006/vcard/ns#fn
ns1:fn rdf:type owl:AnnotationProperty .


###  https://schema.org/domainIncludes
schema:domainIncludes rdf:type owl:AnnotationProperty .


###  https://schema.org/name
schema:name rdf:type owl:AnnotationProperty .


###  https://schema.org/rangeIncludes
schema:rangeIncludes rdf:type owl:AnnotationProperty .


###  https://w3id.org/bam/ficr#according_to
ficr:according_to rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bam/ficr#aboutElement
ficr:aboutElement rdf:type owl:ObjectProperty ;
                  rdfs:domain ficr:BoundaryAssumption ;
                  rdfs:range ficr:PhysicalObject ;
                  rdfs:comment "Links a boundary assumption to the physical element whose fire performance it assesses."@en ;
                  rdfs:label "aboutElement"@en .


###  https://w3id.org/bam/ficr#affectsSystem
ficr:affectsSystem rdf:type owl:ObjectProperty ;
                   rdfs:domain ficr:ImpairmentState ;
                   rdfs:range ficr:BuildingSystem ;
                   rdfs:comment "Links an impairment state to the building system whose operation is degraded."@en ;
                   rdfs:label "affectsSystem"@en .


###  https://w3id.org/bam/ficr#appliesToElementType
ficr:appliesToElementType rdf:type owl:ObjectProperty ;
                          rdfs:domain ficr:RegulatoryRequirement ;
                          rdfs:comment "Specifies the class of physical element this requirement applies to, e.g. ficr:Wall or ficr:Floor."@en ;
                          rdfs:label "appliesToElementType"@en .


###  https://w3id.org/bam/ficr#appliesToPurposeGroup
ficr:appliesToPurposeGroup rdf:type owl:ObjectProperty ;
                           rdfs:domain ficr:RegulatoryRequirement ;
                           rdfs:range ficr:PurposeGroup ;
                           rdfs:comment "Specifies the building purpose group for which this requirement is applicable."@en ;
                           rdfs:label "appliesToPurposeGroup"@en .


###  https://w3id.org/bam/ficr#appliesToRiskUnit
ficr:appliesToRiskUnit rdf:type owl:ObjectProperty ;
                       rdfs:range ficr:RiskUnit ;
                       rdfs:comment "Links a boundary assumption or impairment state to the risk unit it influences."@en ;
                       rdfs:label "appliesToRiskUnit"@en .


###  https://w3id.org/bam/ficr#assessesElement
ficr:assessesElement rdf:type owl:ObjectProperty ;
                     rdfs:domain ficr:Assessment ;
                     rdfs:range ficr:PhysicalObject ;
                     rdfs:comment "Links an assessment to the physical element(s) it evaluates. For compliance assessments, this is the wall, door, or floor being checked. For risk assessments, this covers elements involved in fire spread modelling."@en ;
                     rdfs:label "assessesElement"@en .


###  https://w3id.org/bam/ficr#assessesZone
ficr:assessesZone rdf:type owl:ObjectProperty ;
                  rdfs:domain ficr:Assessment ;
                  rdfs:range bot:Zone ;
                  rdfs:comment "Links an assessment to the zone(s) or space(s) it covers. For risk assessments, this is the space whose fire scenario is being evaluated. For compliance assessments, this is the space containing the assessed elements."@en ;
                  rdfs:label "assessesZone"@en .


###  https://w3id.org/bam/ficr#basedOnRegulation
ficr:basedOnRegulation rdf:type owl:ObjectProperty ;
                       rdfs:domain ficr:ComplianceChecking ;
                       rdfs:range ficr:RegulatorySource ;
                       rdfs:comment "Links a compliance assessment to the regulatory source used to derive the requirement(s)."@en ;
                       rdfs:label "basedOnRegulation"@en .


###  https://w3id.org/bam/ficr#coversSpatialZone
ficr:coversSpatialZone rdf:type owl:ObjectProperty ;
                       rdfs:domain ficr:RiskUnit ;
                       rdfs:range bot:Zone ;
                       rdfs:comment "Links a risk unit to the spatial zone whose fire exposure it aggregates."@en ;
                       rdfs:label "coversSpatialZone"@en .


###  https://w3id.org/bam/ficr#hasAssessmentBasis
ficr:hasAssessmentBasis rdf:type owl:ObjectProperty ;
                        rdfs:domain ficr:Assessment ;
                        rdfs:range ficr:AssessmentBasis ;
                        rdfs:comment "Links an assessment activity or assessment result to the evidence bundle that supports it."@en ;
                        rdfs:label "hasAssessmentBasis"@en .


###  https://w3id.org/bam/ficr#hasAssumptionType
ficr:hasAssumptionType rdf:type owl:ObjectProperty ;
                       rdfs:domain ficr:BoundaryAssumption ;
                       rdfs:range ficr:AssumptionType ;
                       rdfs:comment "Links a boundary assumption to the category of fire loss assumption relied upon."@en ;
                       rdfs:label "hasAssumptionType"@en .


###  https://w3id.org/bam/ficr#hasClassification
ficr:hasClassification rdf:type owl:ObjectProperty ;
                       owl:inverseOf ficr:isClassificationOf ;
                       rdfs:comment "General property relating an entity to its classification."@en ;
                       rdfs:label "hasClassification"@en .


###  https://w3id.org/bam/ficr#hasComplianceResult
ficr:hasComplianceResult rdf:type owl:ObjectProperty ;
                         rdfs:domain ficr:ComplianceChecking ;
                         rdfs:range ficr:ComplianceResult ;
                         rdfs:comment "Links a compliance checking assessment to the compliance result it produces."@en ;
                         rdfs:label "hasComplianceResult"@en .


###  https://w3id.org/bam/ficr#hasComponent
ficr:hasComponent rdf:type owl:ObjectProperty ;
                  owl:inverseOf ficr:isComponentOf ;
                  rdfs:domain ficr:BuildingSystem ;
                  rdfs:range ficr:PhysicalObject ;
                  rdfs:comment "Expressing the compositional relationship of components"@en ;
                  rdfs:label "hasComponent"@en .


###  https://w3id.org/bam/ficr#hasConditionState
ficr:hasConditionState rdf:type owl:ObjectProperty ;
                       rdfs:range ficr:ConditionState ;
                       rdfs:comment "Links a boundary assumption or impairment state to a physical condition state assessment."@en ;
                       rdfs:label "hasConditionState"@en .


###  https://w3id.org/bam/ficr#hasConnectionWith
ficr:hasConnectionWith rdf:type owl:ObjectProperty ;
                       rdfs:comment "indicates that the two individuals have a passageway."@en ;
                       rdfs:label "hasConnectionWith"@en .


###  https://w3id.org/bam/ficr#hasElementUsage
ficr:hasElementUsage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ficr:hasUsageType ;
                     owl:inverseOf ficr:isElementUsageOf ;
                     rdfs:domain ficr:PhysicalObject ;
                     rdfs:range ficr:ElementFireSafetyRole ;
                     rdfs:comment "Links a boundary assumption or impairment state to a physical condition state assessment."@en ;
                     rdfs:label "hasElementUsage"@en .


###  https://w3id.org/bam/ficr#hasFireHazardSeverity
ficr:hasFireHazardSeverity rdf:type owl:ObjectProperty ;
                           rdfs:domain bot:Zone ;
                           rdfs:range ficr:FireHazardSeverity ;
                           rdfs:comment "Links a zone to its fire hazard severity classification (light, moderate, or severe)."@en ;
                           rdfs:label "hasFireHazardSeverity"@en .


###  https://w3id.org/bam/ficr#hasFireRiskUnitRole
ficr:hasFireRiskUnitRole rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf ficr:hasUsageType ;
                         owl:inverseOf ficr:isFireRiskUnitRoleOf ;
                         rdfs:comment "Assigns a fire risk unit role to an entity."@en ;
                         rdfs:label "hasFireRiskUnitRole"@en .


###  https://w3id.org/bam/ficr#hasFireSafetyRole
ficr:hasFireSafetyRole rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ficr:hasUsageType ;
                       owl:inverseOf ficr:isFireSafetyRoleOf ;
                       rdfs:range ficr:FireSafetyRole ;
                       rdfs:comment "General property linking an entity to a fire safety role, parent of hasElementUsage and hasZoneFireSafetyRole."@en ;
                       rdfs:label "hasFireSafetyRole"@en .


###  https://w3id.org/bam/ficr#hasImpairmentState
ficr:hasImpairmentState rdf:type owl:ObjectProperty ;
                        rdfs:range ficr:ImpairmentState ;
                        rdfs:comment "Links a building system or component to its current operational impairment state."@en ;
                        rdfs:label "hasImpairmentState"@en .


###  https://w3id.org/bam/ficr#hasInstallationStatus
ficr:hasInstallationStatus rdf:type owl:ObjectProperty ;
                           rdfs:range ficr:InstallationStatus ;
                           rdfs:comment "Indicates whether this system is installed and to what specification."@en ;
                           rdfs:label "hasInstallationStatus"@en .


###  https://w3id.org/bam/ficr#hasOriginSpace
ficr:hasOriginSpace rdf:type owl:ObjectProperty ;
                    rdfs:domain ficr:FireRiskScenario ;
                    rdfs:range bot:Zone ;
                    rdfs:comment "Links a fire risk scenario to the zone where the fire is modelled to originate."@en ;
                    rdfs:label "hasOriginSpace"@en .


###  https://w3id.org/bam/ficr#hasPurposeGroup
ficr:hasPurposeGroup rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ficr:hasClassification ;
                     owl:inverseOf ficr:isPurposeGroupOf ;
                     rdfs:domain bot:Building ;
                     rdfs:range ficr:PurposeGroup ;
                     rdfs:comment "Relates a building to its functional purpose group classification according to ADB Table 0.1"@en ;
                     rdfs:label "hasPurposeGroup"@en .


###  https://w3id.org/bam/ficr#hasScenario
ficr:hasScenario rdf:type owl:ObjectProperty ;
                 rdfs:domain ficr:RiskAnalysis ;
                 rdfs:range ficr:FireRiskScenario ;
                 rdfs:comment "Links a risk assessment to the fire risk scenario(s) it evaluates. Each scenario represents a hypothetical fire origin and its modelled spread, corresponding to the per-room EML calculations in the FiCR risk model."@en ;
                 rdfs:label "hasScenario"@en .


###  https://w3id.org/bam/ficr#hasSeparationRecord
ficr:hasSeparationRecord rdf:type owl:ObjectProperty ;
                         rdfs:domain ficr:RiskUnit ;
                         rdfs:comment "Links a risk unit to a separation distance record describing its exposure to an adjacent risk unit."@en ;
                         rdfs:label "hasSeparationRecord"@en ;
                         skos:scopeNote "Informational: for future use."@en .


###  https://w3id.org/bam/ficr#hasSpaceUsage
ficr:hasSpaceUsage rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ficr:hasUsageType ;
                   owl:inverseOf ficr:isSpaceUsageOf ;
                   rdfs:range ficr:SpaceUsage ;
                   rdfs:comment "Assigns a functional space usage classification (e.g. Kitchen, Corridor) to a zone or space."@en ;
                   rdfs:label "hasSpaceUsage"@en .


###  https://w3id.org/bam/ficr#hasUsageType
ficr:hasUsageType rdf:type owl:ObjectProperty ;
                  owl:inverseOf ficr:isUsageTypeOf ;
                  rdfs:range ficr:UsageType ;
                  rdfs:comment "Top-level property linking an entity to a usage type classification. Sub-properties specialise domain and range."@en ;
                  rdfs:label "hasUsageType"@en .


###  https://w3id.org/bam/ficr#hasUtilizationPurpose
ficr:hasUtilizationPurpose rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf ficr:hasUsageType ;
                           owl:inverseOf ficr:isUtilizationPurposeOf ;
                           rdfs:range ficr:UtilizationPurpose ;
                           rdfs:comment "Assigns a building planning utilization purpose (e.g. Hotel, Office) to a zone or building."@en ;
                           rdfs:label "hasUtilizationPurpose"@en .


###  https://w3id.org/bam/ficr#hasZoneFireSafetyRole
ficr:hasZoneFireSafetyRole rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf ficr:hasUsageType ;
                           owl:inverseOf ficr:isZoneFireSafetyRole ;
                           rdfs:range ficr:ZoneFireSafetyRole ;
                           rdfs:comment "Assigns a fire safety role to a building zone, enabling zone-level equivalentClass definitions for protected spaces."@en ;
                           rdfs:label "hasZoneFireSafetyRole"@en .


###  https://w3id.org/bam/ficr#isClassificationOf
ficr:isClassificationOf rdf:type owl:ObjectProperty ;
                        rdfs:comment "Inverse of hasClassification."@en ;
                        rdfs:label "isClassificationOf"@en .


###  https://w3id.org/bam/ficr#isComponentOf
ficr:isComponentOf rdf:type owl:ObjectProperty ;
                   rdfs:comment "Links an individual equipment item to the building system it belongs to. Inverse direction of hasComponent at the instance level."@en ;
                   rdfs:label "isComponentOf"@en .


###  https://w3id.org/bam/ficr#isElementUsageOf
ficr:isElementUsageOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ficr:isUsageTypeOf ;
                      rdfs:comment "Inverse of hasElementUsage."@en ;
                      rdfs:label "isElementUsageOf"@en .


###  https://w3id.org/bam/ficr#isExposedTo
ficr:isExposedTo rdf:type owl:ObjectProperty ;
                 rdfs:domain ficr:RiskUnit ;
                 rdfs:range ficr:RiskUnit ;
                 rdfs:comment "Indicates potential fire spread exposure between risk units."@en ;
                 rdfs:label "isExposedTo"@en .


###  https://w3id.org/bam/ficr#isFireRiskUnitRoleOf
ficr:isFireRiskUnitRoleOf rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ficr:isUsageTypeOf ;
                          rdfs:comment "Inverse of hasFireRiskUnitRole."@en ;
                          rdfs:label "isFireRiskUnitRoleOf"@en .


###  https://w3id.org/bam/ficr#isFireSafetyRoleOf
ficr:isFireSafetyRoleOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ficr:isUsageTypeOf ;
                        rdfs:range ficr:FireSafetyRole ;
                        rdfs:comment "Inverse of hasFireSafetyRole."@en ;
                        rdfs:label "isFireSafetyRoleOf"@en .


###  https://w3id.org/bam/ficr#isPurposeGroupOf
ficr:isPurposeGroupOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ficr:isClassificationOf ;
                      rdfs:comment "Inverse of hasPurposeGroup."@en ;
                      rdfs:label "isPurposeGroupOf"@en .


###  https://w3id.org/bam/ficr#isSpaceUsageOf
ficr:isSpaceUsageOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ficr:isUsageTypeOf ;
                    rdfs:comment "Inverse of hasSpaceUsage."@en ;
                    rdfs:label "isSpaceUsageOf"@en .


###  https://w3id.org/bam/ficr#isStoreyAbove
ficr:isStoreyAbove rdf:type owl:ObjectProperty ;
                   rdfs:domain bot:Storey ;
                   rdfs:range bot:Storey ;
                   rdfs:comment "Indicates that the subject storey is directly above the object storey."@en ;
                   rdfs:label "isStoreyAbove"@en .


###  https://w3id.org/bam/ficr#isStoreyBelow
ficr:isStoreyBelow rdf:type owl:ObjectProperty ;
                   rdfs:domain bot:Storey ;
                   rdfs:range bot:Storey ;
                   rdfs:comment "Indicates that the subject storey is directly below the object storey."@en ;
                   rdfs:label "isStoreyBelow"@en .


###  https://w3id.org/bam/ficr#isUsageTypeOf
ficr:isUsageTypeOf rdf:type owl:ObjectProperty ;
                   rdfs:comment "Inverse of hasUsageType."@en ;
                   rdfs:label "isUsageTypeOf"@en .


###  https://w3id.org/bam/ficr#isUtilizationPurposeOf
ficr:isUtilizationPurposeOf rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf ficr:isUsageTypeOf ;
                            rdfs:comment "Inverse of hasUtilizationPurpose."@en ;
                            rdfs:label "isUtilizationPurposeOf"@en .


###  https://w3id.org/bam/ficr#isZoneFireSafetyRole
ficr:isZoneFireSafetyRole rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ficr:isUsageTypeOf ;
                          rdfs:comment "Inverse of hasZoneFireSafetyRole."@en ;
                          rdfs:label "isZoneFireSafetyRole"@en .


###  https://w3id.org/bam/ficr#islocatedIn
ficr:islocatedIn rdf:type owl:ObjectProperty ;
                 rdfs:domain ficr:PhysicalObject ;
                 rdfs:range bot:Zone ;
                 rdfs:comment "describe the location and/or surroundings of a place."@en ;
                 rdfs:label "islocatedIn"@en .


###  https://w3id.org/bam/ficr#producesAssessment
ficr:producesAssessment rdf:type owl:ObjectProperty ;
                        rdfs:domain ficr:Task ;
                        rdfs:range ficr:Assessment ;
                        rdfs:comment "Links a task to assessment outcomes produced by executing it."@en ;
                        rdfs:label "producesAssessment"@en .


###  https://w3id.org/bam/ficr#producesEvidence
ficr:producesEvidence rdf:type owl:ObjectProperty ;
                      rdfs:domain ficr:Task ;
                      rdfs:range ficr:EvidenceItem ;
                      rdfs:comment "Links a task to evidence items it generates."@en ;
                      rdfs:label "producesEvidence"@en .


###  https://w3id.org/bam/ficr#supportedByEvidence
ficr:supportedByEvidence rdf:type owl:ObjectProperty ;
                         rdfs:range ficr:EvidenceItem ;
                         rdfs:comment "Links a boundary assumption or impairment state to the evidence items that justify it."@en ;
                         rdfs:label "supportedByEvidence"@en .


###  https://w3id.org/bam/ficr#triggeredBy
ficr:triggeredBy rdf:type owl:ObjectProperty ;
                 owl:inverseOf ficr:triggersTask ;
                 rdfs:domain ficr:Task ;
                 rdfs:range ficr:Event ;
                 rdfs:comment "A task is created because an event (e.g., risk detected) occurred."@en ;
                 rdfs:label "triggeredBy"@en .


###  https://w3id.org/bam/ficr#triggersTask
ficr:triggersTask rdf:type owl:ObjectProperty ;
                  rdfs:domain ficr:Event ;
                  rdfs:range ficr:Task ;
                  rdfs:comment "Links a trigger event to the task(s) created because of it."@en ;
                  rdfs:label "triggersTask"@en .


###  https://w3id.org/bam/ficr#usesComplianceResult
ficr:usesComplianceResult rdf:type owl:ObjectProperty ;
                          rdfs:domain ficr:RiskAnalysis ;
                          rdfs:range ficr:ComplianceResult ;
                          rdfs:comment "Links a risk assessment to compliance results used as inputs to risk estimation."@en ;
                          rdfs:label "usesComplianceResult"@en .


###  https://w3id.org/bam/ficr#usesEvidence
ficr:usesEvidence rdf:type owl:ObjectProperty ;
                  rdfs:domain ficr:Task ;
                  rdfs:range ficr:EvidenceItem ;
                  rdfs:comment "Links a task to evidence items it consumes as inputs."@en ;
                  rdfs:label "usesEvidence"@en .


###  https://w3id.org/bot#adjacentElement
bot:adjacentElement rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf bot:hasElement ;
                    owl:propertyDisjointWith bot:intersectingElement ;
                    rdfs:label "adjacentElement"@en .


###  https://w3id.org/bot#adjacentZone
bot:adjacentZone rdf:type owl:ObjectProperty ,
                          owl:SymmetricProperty ;
                 rdfs:domain bot:Zone ;
                 rdfs:range bot:Zone ;
                 owl:propertyDisjointWith bot:intersectsZone ;
                 rdfs:comment "Relationship between two zones that share a common interface, but do not intersect."@en ;
                 rdfs:label "adjacentZone"@en .


###  https://w3id.org/bot#containsElement
bot:containsElement rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf bot:hasElement ;
                    owl:propertyChainAxiom ( bot:containsZone
                                             bot:containsElement
                                           ) ;
                    rdfs:label "containsElement"@en .


###  https://w3id.org/bot#containsZone
bot:containsZone rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:domain bot:Zone ;
                 rdfs:range bot:Zone ;
                 rdfs:comment "Relationship to the subzones of a major zone. A space zone could for instance be contained in a storey zone which is further contained in a building zone. bot:containsZone is a transitive property. This implies that in the previous example a bot:containsZone relationship holds between the space zone and the building zone."@en ;
                 rdfs:label "containsZone"@en .


###  https://w3id.org/bot#has3DModel
bot:has3DModel rdf:type owl:ObjectProperty ;
               rdfs:comment "Links any bot:Zone or bot:Element to a IRI that identifies its 3D Model. This 3D Model can then be described using some dedicated RDF vocabulary. Else, the 3D Model IRI could be dereferenceable, and when looking up the IRI one could retrieve a representation of the 3D Model with some existing data format for 3D models."@en ;
               rdfs:label "has3DModel"@en .


###  https://w3id.org/bot#hasBuilding
bot:hasBuilding rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf bot:containsZone ;
                rdfs:domain bot:Zone ;
                rdfs:range bot:Building ;
                rdfs:comment "Relation to buildings contained in a zone. The typical domains of bot:hasBuilding are instances of bot:Site."@en ;
                rdfs:label "hasBuilding"@en .


###  https://w3id.org/bot#hasElement
bot:hasElement rdf:type owl:ObjectProperty ;
               rdfs:domain bot:Zone ;
               rdfs:range bot:Element ;
               owl:propertyChainAxiom ( bot:containsZone
                                        bot:hasElement
                                      ) ;
               rdfs:comment "Links a Zone to an Element that is either contained in, adjacent to or intersecting with the Zone. The intended use of this relationship is not to be stated explicitly, but to be inferred from its sub-properties. It will, for example, allow one to query for all the doors of a building given that they have an adjacency to spaces of the building."@en ;
               rdfs:label "hasElement"@en .


###  https://w3id.org/bot#hasSpace
bot:hasSpace rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf bot:containsZone ;
             rdfs:domain bot:Zone ;
             rdfs:range bot:Space ;
             rdfs:label "hasSpace"@en .


###  https://w3id.org/bot#hasStorey
bot:hasStorey rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf bot:containsZone ;
              rdfs:domain bot:Zone ;
              rdfs:range bot:Storey ;
              rdfs:comment "Relation to storeys contained in a zone. The typical domains of bot:hasStorey are instances of bot:Building."@en ;
              rdfs:label "hasStorey"@en .


###  https://w3id.org/bot#hasSubElement
bot:hasSubElement rdf:type owl:ObjectProperty ;
                  rdfs:domain bot:Element ;
                  rdfs:range bot:Element ;
                  rdfs:label "hasSubElement"@en .


###  https://w3id.org/bot#hasZeroPoint
bot:hasZeroPoint rdf:type owl:ObjectProperty ;
                 rdfs:domain bot:Site ;
                 rdfs:comment "Links a bot:Site to an instance that encodes the latitude and longitude of the Zero Point of the building site. This could be an instance of a wgs84:Point. The definition of GIS and geometry is not within the scope of BOT and an appropriate ontology needs to be selected here by the user. The use of this property is potentially ambiguous and it might be removed or revised in future editions of the ontology."@en ;
                 rdfs:label "hasZeroPoint"@en .


###  https://w3id.org/bot#interfaceOf
bot:interfaceOf rdf:type owl:ObjectProperty ;
                rdfs:domain bot:Interface ;
                rdfs:comment "Relationship between an interface and another thing (building zone, element or owl:Thing)"@en ;
                rdfs:label "interfaceOf"@en .


###  https://w3id.org/bot#intersectingElement
bot:intersectingElement rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf bot:hasElement ;
                        rdfs:comment "Relation between a Zone and a building Element that intersects it."@en ;
                        rdfs:label "intersectingElement"@en .


###  https://w3id.org/bot#intersectsZone
bot:intersectsZone rdf:type owl:ObjectProperty ,
                            owl:SymmetricProperty ;
                   rdfs:domain bot:Zone ;
                   rdfs:range bot:Zone ;
                   rdfs:comment "Relationship between two zones whose 3D extent intersect. For example, a stairwell intersects different storeys."@en ;
                   rdfs:label "intersectsZone"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bam/ficr#declaredExposureValue
ficr:declaredExposureValue rdf:type owl:DatatypeProperty ;
                           rdfs:domain ficr:RiskUnit ;
                           rdfs:range xsd:decimal ;
                           rdfs:label "declaredExposureValue"@en .


###  https://w3id.org/bam/ficr#documentTitle
ficr:documentTitle rdf:type owl:DatatypeProperty ;
                   rdfs:domain ficr:DocumentBasis ;
                   rdfs:range xsd:string ;
                   rdfs:comment "A human-readable title used to display the document in user interfaces."@en ;
                   rdfs:label "documentTitle"@en .


###  https://w3id.org/bam/ficr#documentURI
ficr:documentURI rdf:type owl:DatatypeProperty ;
                 rdfs:domain ficr:DocumentBasis ;
                 rdfs:range xsd:anyURI ;
                 rdfs:comment "A resolvable URI or file path pointing to the document location for human access."@en ;
                 rdfs:label "documentURI"@en .


###  https://w3id.org/bam/ficr#hasActualREI
ficr:hasActualREI rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf ficr:hasREI ;
                  rdfs:domain ficr:FabricElement ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "The actual measured fire resistance period (R=load-bearing, E=integrity, I=insulation) in minutes."@en ;
                  rdfs:label "hasActualREI"@en .


###  https://w3id.org/bam/ficr#hasActualSeparationM
ficr:hasActualSeparationM rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "Measured physical separation distance in metres between two risk units."@en ;
                          rdfs:label "hasActualSeparationM"@en ;
                          skos:scopeNote "Informational: for future use."@en .


###  https://w3id.org/bam/ficr#hasArea
ficr:hasArea rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:decimal ;
             rdfs:comment "The floor area of a space in square metres."@en ;
             rdfs:label "hasArea"@en .


###  https://w3id.org/bam/ficr#hasBuildingHeight
ficr:hasBuildingHeight rdf:type owl:DatatypeProperty ;
                       rdfs:domain bot:Building ;
                       rdfs:range xsd:decimal ;
                       rdfs:comment "Height of a building is measured as shown in Appendix D, Diagram D4."@en ;
                       rdfs:label "hasBuildingHeight"@en .


###  https://w3id.org/bam/ficr#hasCombinedGrossFloorArea
ficr:hasCombinedGrossFloorArea rdf:type owl:DatatypeProperty ;
                               rdfs:domain bot:Building ;
                               rdfs:range xsd:decimal ;
                               rdfs:comment "Total gross floor area of all storeys in a building, in square metres."@en ;
                               rdfs:label "hasCombinedGrossFloorArea"@en .


###  https://w3id.org/bam/ficr#hasCoverageType
ficr:hasCoverageType rdf:type owl:DatatypeProperty ;
                     rdfs:domain ficr:Alarm ;
                     rdfs:comment "The spatial coverage mode of the detector, e.g. PointDetector, BeamDetector, AspiratingDetector."@en ;
                     rdfs:label "hasCoverageType"@en .


###  https://w3id.org/bam/ficr#hasDetectionType
ficr:hasDetectionType rdf:type owl:DatatypeProperty ;
                      rdfs:domain ficr:Alarm ;
                      rdfs:comment "The detection principle of the alarm device, e.g. OpticalSmoke, Ionisation, Heat, MultiSensor, CarbonMonoxide."@en ;
                      rdfs:label "hasDetectionType"@en .


###  https://w3id.org/bam/ficr#hasDirectDistance
ficr:hasDirectDistance rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:decimal ;
                       rdfs:comment "The shortest distance from any point within the floor area to the nearest storey exit, measured within the external enclosures of the building, and ignoring walls, partitions and fittings other than the enclosing walls and partitions to protected stairways."@en ;
                       rdfs:label "hasDirectDistance"@en .


###  https://w3id.org/bam/ficr#hasElevation
ficr:hasElevation rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "The vertical height of a storey floor level above a reference datum, in metres."@en ;
                  rdfs:label "hasElevation"@en .


###  https://w3id.org/bam/ficr#hasExtinguisherAgent
ficr:hasExtinguisherAgent rdf:type owl:DatatypeProperty ;
                          rdfs:domain ficr:FireExtinguisher ;
                          rdfs:comment "The extinguishing agent type, e.g. DryPowder, CO2, WaterMist, WetChemical, Foam."@en ;
                          rdfs:label "hasExtinguisherAgent"@en .


###  https://w3id.org/bam/ficr#hasFireClassRating
ficr:hasFireClassRating rdf:type owl:DatatypeProperty ;
                        rdfs:domain ficr:FireExtinguisher ;
                        rdfs:comment "The fire class rating per BS EN 2, e.g. A, B, AB, ABC, AF."@en ;
                        rdfs:label "hasFireClassRating"@en .


###  https://w3id.org/bam/ficr#hasFixedAssetValue
ficr:hasFixedAssetValue rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:decimal ;
                        rdfs:comment "This refers to the total asset value of the space."@en ;
                        rdfs:label "hasFixedAssetValue"@en .


###  https://w3id.org/bam/ficr#hasID
ficr:hasID rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:comment "A unique identifier string for the entity."@en ;
           rdfs:label "hasID"@en .


###  https://w3id.org/bam/ficr#hasLength
ficr:hasLength rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:decimal ;
               rdfs:comment "The length dimension of a building element, in metres."@en ;
               rdfs:label "hasLength"@en .


###  https://w3id.org/bam/ficr#hasNumberOfStoreys
ficr:hasNumberOfStoreys rdf:type owl:DatatypeProperty ;
                        rdfs:domain bot:Building ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "Number of storeys excluding basements"@en ;
                        rdfs:label "hasNumberOfStoreys"@en .


###  https://w3id.org/bam/ficr#hasREI
ficr:hasREI rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:integer ;
            rdfs:comment "Fire resistance period expressed as R (load-bearing), E (integrity), I (insulation), in minutes."@en ;
            rdfs:label "hasREI"@en .


###  https://w3id.org/bam/ficr#hasRequiredREI
ficr:hasRequiredREI rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf ficr:hasREI ;
                    rdfs:domain ficr:RegulatoryRequirement ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "The minimum REI value mandated by regulation for a given element type and purpose group, in minutes."@en ;
                    rdfs:label "hasRequiredREI"@en .


###  https://w3id.org/bam/ficr#hasRequiredSeparationM
ficr:hasRequiredSeparationM rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Minimum separation distance in metres required to prevent fire spread, computed per NFPA 80A. Stored here as an externally-supplied value; FiCR does not compute this internally."@en ;
                            rdfs:label "hasRequiredSeparationM"@en ;
                            skos:scopeNote "Informational: for future use."@en .


###  https://w3id.org/bam/ficr#hasServiceExpiryDate
ficr:hasServiceExpiryDate rdf:type owl:DatatypeProperty ;
                          rdfs:domain ficr:Equipment ;
                          rdfs:comment "The date by which the equipment must be serviced or replaced to remain compliant."@en ;
                          rdfs:label "hasServiceExpiryDate"@en .


###  https://w3id.org/bam/ficr#hasStandardUnitValue
ficr:hasStandardUnitValue rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "A standard monetary unit value per square metre used in insurance risk calculations."@en ;
                          rdfs:label "hasStandardUnitValue"@en .


###  https://w3id.org/bam/ficr#hasStoreyHeight
ficr:hasStoreyHeight rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "The floor-to-floor height of a storey, in metres."@en ;
                     rdfs:label "hasStoreyHeight"@en .


###  https://w3id.org/bam/ficr#hasThickness
ficr:hasThickness rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "The thickness dimension of a building element, in metres."@en ;
                  rdfs:label "hasThickness"@en .


###  https://w3id.org/bam/ficr#hasTopStoreyFloorHeight
ficr:hasTopStoreyFloorHeight rdf:type owl:DatatypeProperty ;
                             rdfs:domain bot:Building ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "Height of the floor of the top storey above ground level is measured as shown in Appendix D, Diagram D6."@en ;
                             rdfs:label "hasTopStoreyFloorHeight"@en .


###  https://w3id.org/bam/ficr#hasTopStoreyHeight
ficr:hasTopStoreyHeight rdf:type owl:DatatypeProperty ;
                        rdfs:domain bot:Building ;
                        rdfs:range xsd:decimal ;
                        rdfs:comment "The floor-to-ceiling height of the topmost storey, in metres."@en ;
                        rdfs:label "hasTopStoreyHeight"@en .


###  https://w3id.org/bam/ficr#hasTravelDistance
ficr:hasTravelDistance rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:decimal ;
                       rdfs:comment "(unless otherwise specified, e.g. as in the case of flats) The distance that a person would travel from any point within the floor area to the nearest storey exit, determined by the layout of walls, partitions and fittings."@en ;
                       rdfs:label "hasTravelDistance"@en .


###  https://w3id.org/bam/ficr#hasValue
ficr:hasValue rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:decimal ;
              rdfs:comment "The value of a physical object, such as the value of furniture."@en ;
              rdfs:label "hasValue"@en .


###  https://w3id.org/bam/ficr#hasVolume
ficr:hasVolume rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:decimal ;
               rdfs:comment "The volume of a space, in cubic metres."@en ;
               rdfs:label "hasVolume"@en .


###  https://w3id.org/bam/ficr#hasWallOpeningRatio
ficr:hasWallOpeningRatio rdf:type owl:DatatypeProperty ;
                         rdfs:domain ficr:ExternalWall ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "hasWallOpeningRatio"@en .


###  https://w3id.org/bam/ficr#hasWidth
ficr:hasWidth rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:decimal ;
              rdfs:comment "The width dimension of a building element, in metres."@en ;
              rdfs:label "hasWidth"@en .


###  https://w3id.org/bam/ficr#isAboveGround
ficr:isAboveGround rdf:type owl:DatatypeProperty ;
                   rdfs:domain bot:Storey ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Determine whether the storey is a basement or above ground."@en ;
                   rdfs:label "isAboveGround"@en .


###  https://w3id.org/bam/ficr#isDamaged
ficr:isDamaged rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Boolean indicating whether the element shows visible damage affecting its fire performance."@en ;
               rdfs:label "isDamaged"@en .


###  https://w3id.org/bam/ficr#isEnclosed
ficr:isEnclosed rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Boolean indicating whether the element or space is fully enclosed by construction."@en ;
                rdfs:label "isEnclosed"@en .


###  https://w3id.org/bam/ficr#isExternal
ficr:isExternal rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Boolean indicating whether the element forms part of the external building envelope."@en ;
                rdfs:label "isExternal"@en .


###  https://w3id.org/bam/ficr#isLoadBearing
ficr:isLoadBearing rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Boolean indicating whether the element carries structural loads."@en ;
                   rdfs:label "isLoadBearing"@en .


###  https://w3id.org/bam/ficr#isObscured
ficr:isObscured rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Refers to the state of being obscured."@en ;
                rdfs:label "isObscured"@en .


###  https://w3id.org/bam/ficr#plannedEndTime
ficr:plannedEndTime rdf:type owl:DatatypeProperty ;
                    rdfs:domain ficr:Task ;
                    rdfs:range xsd:dateTime ;
                    rdfs:comment "The scheduled end date and time of a task."@en ;
                    rdfs:label "plannedEndTime"@en .


###  https://w3id.org/bam/ficr#plannedStartTime
ficr:plannedStartTime rdf:type owl:DatatypeProperty ;
                      rdfs:domain ficr:Task ;
                      rdfs:range xsd:dateTime ;
                      rdfs:comment "The scheduled start date and time of a task."@en ;
                      rdfs:label "plannedStartTime"@en .


###  https://w3id.org/bam/ficr#requiresInspection
ficr:requiresInspection rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment "Must be subject to inspection assignments (e.g., fire safety inspections)."@en ;
                        rdfs:label "requiresInspection"@en .


###  https://w3id.org/bot#hasSimple3DModel
bot:hasSimple3DModel rdf:type owl:DatatypeProperty ;
                     rdfs:comment "Links any bot:Zone or bot:Element to a 3D Model encoded as a literal."@en ;
                     rdfs:label "hasSimple3DModel"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bam/ficr#AccessRoomRole
ficr:AccessRoomRole rdf:type owl:Class ;
                    rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#Accommodation
ficr:Accommodation rdf:type owl:Class ;
                   rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#ActiveFireProtectionRole
ficr:ActiveFireProtectionRole rdf:type owl:Class ;
                              rdfs:subClassOf ficr:FireSafetyRole .


###  https://w3id.org/bam/ficr#Alarm
ficr:Alarm rdf:type owl:Class ;
           rdfs:subClassOf ficr:Equipment ;
           rdfs:comment "An alarm in a building is a system designed to alert occupants to a potential danger, such as fire or intrusion, and consists of detectors, warning devices, and control equipment."@en ;
           rdfs:label "Alarm"@en .


###  https://w3id.org/bam/ficr#AlarmInstallationStatus
ficr:AlarmInstallationStatus rdf:type owl:Class ;
                             rdfs:subClassOf ficr:InstallationStatus ;
                             rdfs:comment "Installation and specification status of fire alarm systems."@en ;
                             rdfs:label "AlarmInstallationStatus"@en .


###  https://w3id.org/bam/ficr#AlternativeEscapeRouteRole
ficr:AlternativeEscapeRouteRole rdf:type owl:Class ;
                                rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#AlternativeExitRole
ficr:AlternativeExitRole rdf:type owl:Class ;
                         rdfs:subClassOf ficr:FireSafetyRole .


###  https://w3id.org/bam/ficr#AnomalyTriggerEvent
ficr:AnomalyTriggerEvent rdf:type owl:Class ;
                         rdfs:subClassOf ficr:Event ;
                         rdfs:comment "A trigger event generated when abnormal conditions are detected by monitoring or analytics, causing tasks to be created for verification, inspection, or risk follow-up."@en ;
                         rdfs:label "AnomalyTriggerEvent"@en .


###  https://w3id.org/bam/ficr#ApplianceVentilationDuct
ficr:ApplianceVentilationDuct rdf:type owl:Class ;
                              rdfs:subClassOf ficr:HVACSystem ;
                              rdfs:comment "A duct to deliver combustion air to a gas appliance."@en ;
                              rdfs:label "ApplianceVentilationDuct"@en .


###  https://w3id.org/bam/ficr#AssemblyPlace
ficr:AssemblyPlace rdf:type owl:Class ;
                   rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Assessment
ficr:Assessment rdf:type owl:Class ;
                rdfs:comment "An assessment outcome produced by executing tasks, supported by evidence, and traceable to triggering events."@en ;
                rdfs:label "Assessment"@en .


###  https://w3id.org/bam/ficr#AssessmentBasis
ficr:AssessmentBasis rdf:type owl:Class ;
                     rdfs:comment "A bundle of evidence items used to justify a fire compliance evaluation or risk assessment. It groups observed site evidence, regulatory sources, and supporting external documents for traceability and explanation."@en ;
                     rdfs:label "AssessmentBasis"@en .


###  https://w3id.org/bam/ficr#AssumptionType
ficr:AssumptionType rdf:type owl:Class ;
                    rdfs:comment "The different types of assumptions relied upon include: floor partitions prevent vertical spread, internal cavities do not spread fire, external walls do not cause external spread, and building structural stability."@en ;
                    rdfs:label "AssumptionType"@en .


###  https://w3id.org/bam/ficr#AtriumSpace
ficr:AtriumSpace rdf:type owl:Class ;
                 rdfs:subClassOf bot:Space ;
                 owl:disjointWith ficr:BalconySpace ,
                                  ficr:CavitySpace ,
                                  ficr:DuctSpace ,
                                  ficr:RoofSpace ,
                                  ficr:RoomSpace ,
                                  ficr:ShaftSpace ,
                                  ficr:StairSpace ;
                 rdfs:comment """A continuous space that passes through one or more structural floors within a building, not necessarily vertically.
Enclosed lift wells, enclosed escalator wells, building services ducts and stairs are not classified as atria."""@en ;
                 rdfs:label "AtriumSpace"@en .


###  https://w3id.org/bam/ficr#Auditorium
ficr:Auditorium rdf:type owl:Class ;
                rdfs:subClassOf ficr:SpaceUsage ;
                owl:disjointWith ficr:Bathroom ,
                                 ficr:CirculationUsage ,
                                 ficr:Gallery ,
                                 ficr:HabitableRoom ,
                                 ficr:Kitchen ,
                                 ficr:PlaceOfSpecialHazard ,
                                 ficr:ServiceUsage ,
                                 ficr:Warehouse .


###  https://w3id.org/bam/ficr#AutomaticReleaseMechanism
ficr:AutomaticReleaseMechanism rdf:type owl:Class ;
                               rdfs:subClassOf ficr:FireSafetySystem ;
                               rdfs:comment """A device that normally holds a door open, but closes it automatically if any one of the following occurs.
• Smoke is detected by an automatic device of a suitable nature and quality in a suitable location.
• A hand-operated switch, fitted in a suitable position, is operated.
• The electricity supply to the device, apparatus or switch fails.
• The fire alarm system, if any, is operated."""@en ;
                               rdfs:label "AutomaticReleaseMechanism"@en .


###  https://w3id.org/bam/ficr#BalconySpace
ficr:BalconySpace rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( bot:Space
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ficr:isExternal ;
                                                               owl:hasValue "true"^^xsd:boolean
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf bot:Space ;
                  owl:disjointWith ficr:CavitySpace ,
                                   ficr:DuctSpace ,
                                   ficr:RoofSpace ,
                                   ficr:RoomSpace ,
                                   ficr:ShaftSpace ,
                                   ficr:StairSpace ;
                  rdfs:comment "A balcony is a platform projecting from the wall of a building, enclosed by a balustrade or railing, and accessed from an upper-level room."@en ;
                  rdfs:label "BalconySpace"@en .


###  https://w3id.org/bam/ficr#BasementStorey
ficr:BasementStorey rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( bot:Storey
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ficr:isAboveGround ;
                                                                 owl:hasValue "false"^^xsd:boolean
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf bot:Storey ;
                    owl:disjointWith ficr:GroundAndAboveStorey ;
                    rdfs:comment "A storey with a floor that, at some point, is more than 1200mm below the highest level of ground beside the outside walls. (However, see Appendix B, paragraph B26c, for situations where the storey is considered to be a basement only because of a sloping site.)"@en ;
                    rdfs:label "BasementStorey"@en .


###  https://w3id.org/bam/ficr#Bathroom
ficr:Bathroom rdf:type owl:Class ;
              rdfs:subClassOf ficr:SpaceUsage ;
              owl:disjointWith ficr:CirculationUsage ,
                               ficr:Gallery ,
                               ficr:HabitableRoom ,
                               ficr:Kitchen ,
                               ficr:PlaceOfSpecialHazard ,
                               ficr:ServiceUsage ,
                               ficr:Warehouse .


###  https://w3id.org/bam/ficr#Beam
ficr:Beam rdf:type owl:Class ;
          rdfs:subClassOf ficr:StructuralElement ;
          rdfs:comment "A beam is a horizontal structural element that carries loads perpendicular to its length, transferring weight from a roof, floor, or ceiling to vertical supports like columns or walls."@en ;
          rdfs:label "Beam"@en .


###  https://w3id.org/bam/ficr#BoardingHouse
ficr:BoardingHouse rdf:type owl:Class ;
                   rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#BoilerRoom
ficr:BoilerRoom rdf:type owl:Class ;
                rdfs:subClassOf ficr:PlaceOfSpecialHazard ;
                owl:disjointWith ficr:EngineRoom ,
                                 ficr:FuelStorage ,
                                 ficr:SwitchGearRoom ,
                                 ficr:TransformerRoom .


###  https://w3id.org/bam/ficr#Boundary
ficr:Boundary rdf:type owl:Class ;
              rdfs:subClassOf bot:Zone ;
              rdfs:comment "The boundary of the land that belongs to a building, or, where the land abuts a road, railway, canal or river, the centre line of that road, railway, canal or river."@en ;
              rdfs:label "Boundary"@en .


###  https://w3id.org/bam/ficr#BoundaryAssumption
ficr:BoundaryAssumption rdf:type owl:Class ;
                        rdfs:comment "Indicates fire loss boundary"@en ;
                        rdfs:label "BoundaryAssumption"@en .


###  https://w3id.org/bam/ficr#BuildingContent
ficr:BuildingContent rdf:type owl:Class ;
                     rdfs:subClassOf ficr:PhysicalObject ;
                     rdfs:comment "Furniture, equipment, inventory - not part of building structure."@en ;
                     rdfs:label "BuildingContent"@en .


###  https://w3id.org/bam/ficr#BuildingSystem
ficr:BuildingSystem rdf:type owl:Class ;
                    rdfs:comment "A building system refers to the interconnected, functional components of a building, including its mechanical, and electrical infrastructure."@en ;
                    rdfs:label "BuildingSystem"@en .


###  https://w3id.org/bam/ficr#CarParking
ficr:CarParking rdf:type owl:Class ;
                rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#CavityBarrier
ficr:CavityBarrier rdf:type owl:Class ;
                   rdfs:subClassOf ficr:FireSafetySystem ;
                   rdfs:comment """A construction within a cavity, other than a smoke curtain, to perform either of the
following functions.
• Close a cavity to stop smoke or flame entering.
• Restrict the movement of smoke or flame within a cavity."""@en ;
                   rdfs:label "CavityBarrier"@en .


###  https://w3id.org/bam/ficr#CavityBarrierAssumption
ficr:CavityBarrierAssumption rdf:type owl:Class ;
                             rdfs:subClassOf ficr:AssumptionType .


###  https://w3id.org/bam/ficr#CavitySpace
ficr:CavitySpace rdf:type owl:Class ;
                 rdfs:subClassOf bot:Space ;
                 owl:disjointWith ficr:DuctSpace ,
                                  ficr:RoofSpace ,
                                  ficr:RoomSpace ,
                                  ficr:ShaftSpace ,
                                  ficr:StairSpace ;
                 rdfs:comment "A space enclosed by elements of a building (including a suspended ceiling) or contained within an element, but that is not a room, cupboard, circulation space, protected shaft, or space within a flue, chute, duct, pipe or conduit."@en ;
                 rdfs:label "CavitySpace"@en .


###  https://w3id.org/bam/ficr#Ceiling
ficr:Ceiling rdf:type owl:Class ;
             rdfs:subClassOf ficr:FabricElement ;
             rdfs:comment """Part of a building that encloses a room, protected shaft or circulation space and is exposed overhead.
The soffit of a rooflight, but not the frame, is included as part of the surface of the ceiling. An upstand below a rooflight is considered as a wall."""@en ;
             rdfs:label "Ceiling"@en .


###  https://w3id.org/bam/ficr#Circuit
ficr:Circuit rdf:type owl:Class ;
             rdfs:subClassOf ficr:ElectricalSystem ;
             rdfs:comment "A continuous pathway that allows electricity to flow from the main supply (consumer unit) to various outlets, lights, or appliances, and back again."@en ;
             rdfs:label "Circuit"@en .


###  https://w3id.org/bam/ficr#CirculationSpaceRole
ficr:CirculationSpaceRole rdf:type owl:Class ;
                          rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#CirculationUsage
ficr:CirculationUsage rdf:type owl:Class ;
                      rdfs:subClassOf ficr:SpaceUsage ;
                      owl:disjointWith ficr:Gallery ,
                                       ficr:HabitableRoom ,
                                       ficr:Kitchen ,
                                       ficr:PlaceOfSpecialHazard ,
                                       ficr:ServiceUsage ,
                                       ficr:Warehouse .


###  https://w3id.org/bam/ficr#Cladding
ficr:Cladding rdf:type owl:Class ;
              rdfs:subClassOf ficr:ExternalWall ;
              rdfs:comment "Cladding is an external layer applied to a building's structure to provide weather protection, thermal insulation, and improved aesthetics."@en ;
              rdfs:label "Cladding"@en .


###  https://w3id.org/bam/ficr#Classification
ficr:Classification rdf:type owl:Class ;
                    rdfs:comment "Classify buildings or compartments according to their intended use, construction type, or structural risk to ensure safety, regulatory compliance, and facilitate communication between professionals such as planners, insurers, and contractors."@en ;
                    rdfs:label "Classification"@en .


###  https://w3id.org/bam/ficr#Closing
ficr:Closing rdf:type owl:Class ;
             rdfs:subClassOf ficr:FabricElement ;
             rdfs:comment "A fabric element category for components that close openings in the building envelope or internal partitions, including doors, windows, and dampers."@en ;
             rdfs:label "Closing"@en .


###  https://w3id.org/bam/ficr#Column
ficr:Column rdf:type owl:Class ;
            rdfs:subClassOf ficr:StructuralElement ;
            rdfs:comment "A column is a vertical structural element in a building that supports loads from above and transfers them down to the foundation."@en ;
            rdfs:label "Column"@en .


###  https://w3id.org/bam/ficr#CommercialPlace
ficr:CommercialPlace rdf:type owl:Class ;
                     rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#CompartmentFloor
ficr:CompartmentFloor rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ficr:Floor
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty ficr:hasElementUsage ;
                                                                   owl:someValuesFrom ficr:FireSeparatingRole
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ficr:FireSafetySystem ;
                      rdfs:comment "A fire resisting floor to separate one fire compartment from another."@en ;
                      rdfs:label "CompartmentFloor"@en .


###  https://w3id.org/bam/ficr#CompartmentWall
ficr:CompartmentWall rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( ficr:Wall
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty ficr:hasElementUsage ;
                                                                  owl:someValuesFrom ficr:FireSeparatingRole
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf ficr:FireSafetySystem ;
                     rdfs:comment """A fire resisting wall to separate one fire compartment from another.
including a wall that is common to two or more buildings."""@en ;
                     rdfs:label "CompartmentWall"@en .


###  https://w3id.org/bam/ficr#CompartmentationAssumption
ficr:CompartmentationAssumption rdf:type owl:Class ;
                                rdfs:subClassOf ficr:AssumptionType .


###  https://w3id.org/bam/ficr#ComplianceChecking
ficr:ComplianceChecking rdf:type owl:Class ;
                        rdfs:subClassOf ficr:Assessment ;
                        rdfs:comment "An assessment that determines whether requirements derived from a regulatory source are satisfied, producing a compliance result and justification."@en ;
                        rdfs:label "ComplianceChecking"@en .


###  https://w3id.org/bam/ficr#ComplianceCheckingTask
ficr:ComplianceCheckingTask rdf:type owl:Class ;
                            rdfs:subClassOf ficr:Task ;
                            rdfs:comment "A task that evaluates one or more requirements against available evidence and produces a compliance result."@en ;
                            rdfs:label "ComplianceCheckingTask"@en .


###  https://w3id.org/bam/ficr#ComplianceRequestTriggerEvent
ficr:ComplianceRequestTriggerEvent rdf:type owl:Class ;
                                   rdfs:subClassOf ficr:Event ;
                                   rdfs:comment "A trigger event created when a compliance request is received from an external authority, or when a prior task identifies missing evidence or unmet preconditions requiring follow-up inspection or assessment."@en ;
                                   rdfs:label "ComplianceRequestTriggerEvent"@en .


###  https://w3id.org/bam/ficr#ComplianceResult
ficr:ComplianceResult rdf:type owl:Class ;
                      rdfs:comment "The outcome of a compliance assessment, representing a discrete compliance status such as compliant, non-compliant, or undetermined. It is produced by a ComplianceAssessment via hasComplianceResult and can be consumed by a FireRiskAssessmentTask via usesComplianceResult to inform risk calculations."@en ;
                      rdfs:label "ComplianceResult"@en .


###  https://w3id.org/bam/ficr#CompliantResult
ficr:CompliantResult rdf:type owl:Class ;
                     rdfs:subClassOf ficr:ComplianceResult .


###  https://w3id.org/bam/ficr#Compromised
ficr:Compromised rdf:type owl:Class ;
                 rdfs:subClassOf ficr:ConditionState .


###  https://w3id.org/bam/ficr#ConditionState
ficr:ConditionState rdf:type owl:Class ;
                    rdfs:comment "Physical performance status assessment of boundary condition state."@en ;
                    rdfs:label "ConditionState"@en .


###  https://w3id.org/bam/ficr#Controller
ficr:Controller rdf:type owl:Class ;
                rdfs:subClassOf ficr:Equipment ;
                rdfs:comment "In buildings, a \"controller\" is the \"brain\" of an automated system, receiving data from sensors and sending commands to devices like HVAC, lighting, and alarms to ensure comfort and efficiency."@en ;
                rdfs:label "Controller"@en .


###  https://w3id.org/bam/ficr#Corridor
ficr:Corridor rdf:type owl:Class ;
              rdfs:subClassOf ficr:CirculationUsage ;
              owl:disjointWith ficr:EntranceHall ,
                               ficr:Foyer ,
                               ficr:Hall ,
                               ficr:Lobby .


###  https://w3id.org/bam/ficr#Curtain
ficr:Curtain rdf:type owl:Class ;
             rdfs:subClassOf ficr:FabricElement ;
             rdfs:comment "Part of a solar shading device which is set in motion by the operating system and fulfils the purpose of a blind, awning or shutter."@en ;
             rdfs:label "Curtain"@en .


###  https://w3id.org/bam/ficr#DeadEndRole
ficr:DeadEndRole rdf:type owl:Class ;
                 rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#DetentionHouse
ficr:DetentionHouse rdf:type owl:Class ;
                    rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#DocumentBasis
ficr:DocumentBasis rdf:type owl:Class ;
                   rdfs:subClassOf ficr:AssessmentBasis ;
                   rdfs:comment "An external file or record that supports assessment or documentation, such as product data sheets, installation manuals, certificates, drawings, or inspection reports. It is linked for human access and traceability and does not directly participate in logical inference unless explicitly modelled."@en ;
                   rdfs:label "DocumentBasis"@en .


###  https://w3id.org/bam/ficr#Doorset
ficr:Doorset rdf:type owl:Class ;
             rdfs:subClassOf ficr:Closing ;
             rdfs:comment "A doorset is a complete, integrated door system consisting of the door leaf, frame, and all necessary hardware like hinges, seals, and closers, sold as a single unit from one source."@en ;
             rdfs:label "Doorset"@en .


###  https://w3id.org/bam/ficr#DuctSpace
ficr:DuctSpace rdf:type owl:Class ;
               rdfs:subClassOf bot:Space ;
               owl:disjointWith ficr:RoofSpace ,
                                ficr:RoomSpace ,
                                ficr:ShaftSpace ,
                                ficr:StairSpace ;
               rdfs:comment "A duct space is a designated area or channel within a building that houses the systems for conveying air, cables, and other utilities."@en ;
               rdfs:label "DuctSpace"@en .


###  https://w3id.org/bam/ficr#Dwellinghouse
ficr:Dwellinghouse rdf:type owl:Class ;
                   rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Effective
ficr:Effective rdf:type owl:Class ;
               rdfs:subClassOf ficr:ConditionState .


###  https://w3id.org/bam/ficr#ElectricalSystem
ficr:ElectricalSystem rdf:type owl:Class ;
                      rdfs:subClassOf ficr:BuildingSystem ;
                      rdfs:comment "An electrical system in a building is a network of wiring, equipment, and protective devices that safely distributes power from its entry point to all the loads, such as lights, outlets, and appliances, within the structure."@en ;
                      rdfs:label "ElectricalSystem"@en .


###  https://w3id.org/bam/ficr#ElementFireSafetyRole
ficr:ElementFireSafetyRole rdf:type owl:Class ;
                           rdfs:subClassOf ficr:FireSafetyRole .


###  https://w3id.org/bam/ficr#EmergencyLighting
ficr:EmergencyLighting rdf:type owl:Class ;
                       rdfs:subClassOf ficr:ElectricalSystem ;
                       rdfs:comment "Lighting for use when the power supply to the normal lighting fails."@en ;
                       rdfs:label "EmergencyLighting"@en .


###  https://w3id.org/bam/ficr#EngineRoom
ficr:EngineRoom rdf:type owl:Class ;
                rdfs:subClassOf ficr:PlaceOfSpecialHazard ;
                owl:disjointWith ficr:FuelStorage ,
                                 ficr:SwitchGearRoom ,
                                 ficr:TransformerRoom .


###  https://w3id.org/bam/ficr#EntertainmentPlace
ficr:EntertainmentPlace rdf:type owl:Class ;
                        rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#EntranceHall
ficr:EntranceHall rdf:type owl:Class ;
                  rdfs:subClassOf ficr:CirculationUsage ;
                  owl:disjointWith ficr:Foyer ,
                                   ficr:Hall ,
                                   ficr:Lobby .


###  https://w3id.org/bam/ficr#Equipment
ficr:Equipment rdf:type owl:Class ;
               rdfs:subClassOf ficr:PhysicalObject ,
                               bot:Element ;
               rdfs:comment "Independently identifiable. Maintainable/inspectable. Usually has a model/serial number. Replaceable physical device or apparatus."@en ;
               rdfs:label "Equipment"@en .


###  https://w3id.org/bam/ficr#EquipmentInspectionTask
ficr:EquipmentInspectionTask rdf:type owl:Class ;
                             rdfs:subClassOf ficr:Task ;
                             rdfs:comment "Inspection task consumes observations produced by upstream tools."@en ;
                             rdfs:label "EquipmentInspectionTask"@en .


###  https://w3id.org/bam/ficr#EscapeLighting
ficr:EscapeLighting rdf:type owl:Class ;
                    rdfs:subClassOf ficr:EmergencyLighting ;
                    rdfs:comment "The part of the emergency lighting that is provided to ensure that the escape route is illuminated at all material times."@en ;
                    rdfs:label "EscapeLighting"@en .


###  https://w3id.org/bam/ficr#EvacuationLift
ficr:EvacuationLift rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( ficr:LiftSystem
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ficr:hasElementUsage ;
                                                                 owl:someValuesFrom ficr:EvacuationRole
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf ficr:LiftSystem ;
                    rdfs:comment "A lift that may be used to evacuate people in a fire."@en ;
                    rdfs:label "EvacuationLift"@en .


###  https://w3id.org/bam/ficr#EvacuationRole
ficr:EvacuationRole rdf:type owl:Class ;
                    rdfs:subClassOf ficr:ElementFireSafetyRole .


###  https://w3id.org/bam/ficr#Event
ficr:Event rdf:type owl:Class ;
           rdfs:comment "An occurrence that triggers the creation of one or more tasks in the FiCR workflow, such as a routine schedule, an anomaly alert, or a compliance request."@en ;
           rdfs:label "Event"@en .


###  https://w3id.org/bam/ficr#EvidenceItem
ficr:EvidenceItem rdf:type owl:Class ;
                  rdfs:subClassOf ficr:AssessmentBasis ;
                  rdfs:comment "A single piece of evidence that supports an assessment. It may be an observation, a regulatory reference, or an external document. Evidence items are linkable, traceable, and can be attached to specific assets, spaces, or checks."@en ;
                  rdfs:label "EvidenceItem"@en .


###  https://w3id.org/bam/ficr#ExitPassagewayRole
ficr:ExitPassagewayRole rdf:type owl:Class ;
                        rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#ExternalSpreadAssumption
ficr:ExternalSpreadAssumption rdf:type owl:Class ;
                              rdfs:subClassOf ficr:AssumptionType .


###  https://w3id.org/bam/ficr#ExternalWall
ficr:ExternalWall rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( ficr:Wall
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ficr:isExternal ;
                                                               owl:hasValue "true"^^xsd:boolean
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf ficr:Wall ;
                  rdfs:comment """The external wall of a building includes all of the following.
• Anything located within any space forming part of the wall.
• Any decoration or other finish applied to any external (but not internal) surface forming part of the wall.
• Any windows and doors in the wall.
• Any part of a roof pitched at an angle of more than 70 degrees to the horizontal if that part of the roof adjoins a space within the building to which persons have access, but not access only for the purpose of carrying out repairs or maintenance."""@en ;
                  rdfs:label "ExternalWall"@en .


###  https://w3id.org/bam/ficr#ExternalWallDoor
ficr:ExternalWallDoor rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ficr:Doorset
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty ficr:isExternal ;
                                                                   owl:hasValue "true"^^xsd:boolean
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ficr:Doorset ;
                      rdfs:comment "An external wall door is a door that is part of a building's exterior wall, providing an entrance and exit to the building."@en ;
                      rdfs:label "ExternalWallDoor"@en .


###  https://w3id.org/bam/ficr#ExternalWallWindow
ficr:ExternalWallWindow rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( ficr:Window
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty ficr:isExternal ;
                                                                     owl:hasValue "true"^^xsd:boolean
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf ficr:Window ;
                        rdfs:comment "An external wall window is a window that is part of a building's exterior wall, which acts as the outer boundary separating the interior from the outside environment."@en ;
                        rdfs:label "ExternalWallWindow"@en .


###  https://w3id.org/bam/ficr#FabricElement
ficr:FabricElement rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PhysicalObject ,
                                   bot:Element ;
                   rdfs:comment "Building structural components. Aligning the BuildingElement with the BOT."@en ;
                   rdfs:label "FabricElement"@en .


###  https://w3id.org/bam/ficr#Factory
ficr:Factory rdf:type owl:Class ;
             rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#FinalExitRole
ficr:FinalExitRole rdf:type owl:Class ;
                   rdfs:subClassOf ficr:FireSafetyRole .


###  https://w3id.org/bam/ficr#Finishes
ficr:Finishes rdf:type owl:Class ;
              rdfs:subClassOf ficr:BuildingContent ;
              rdfs:comment "Finishes are the final surface treatments and decorative elements applied to a building's interior and exterior."@en ;
              rdfs:label "Finishes"@en .


###  https://w3id.org/bam/ficr#FireAlarmSystem
ficr:FireAlarmSystem rdf:type owl:Class ;
                     rdfs:subClassOf ficr:FireSafetySystem ;
                     rdfs:comment "Combination of components for giving an audible and/or other perceptible warning of fire."@en ;
                     rdfs:label "FireAlarmSystem"@en .


###  https://w3id.org/bam/ficr#FireAndSmokeDamper
ficr:FireAndSmokeDamper rdf:type owl:Class ;
                        rdfs:subClassOf ficr:FireDamper ;
                        rdfs:comment "A fire damper which, in addition to the performance of the fire damper, resists the spread of smoke."@en ;
                        rdfs:label "FireAndSmokeDamper"@en .


###  https://w3id.org/bam/ficr#FireCompartment
ficr:FireCompartment rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty bot:adjacentElement ;
                                                                  owl:someValuesFrom ficr:CompartmentFloor
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty bot:adjacentElement ;
                                                                  owl:someValuesFrom ficr:CompartmentWall
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf ficr:FireSafetySpace ;
                     rdfs:comment "A fire safety space bounded by compartment walls and compartment floors, designed to prevent the spread of fire and smoke beyond the compartment of origin."@en ;
                     rdfs:label "FireCompartment"@en .


###  https://w3id.org/bam/ficr#FireDamper
ficr:FireDamper rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( ficr:Closing
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty ficr:hasElementUsage ;
                                                             owl:someValuesFrom ficr:FireResistingRole
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf ficr:FireSafetySystem ;
                rdfs:comment "A mechanical or intumescent device within a duct or ventilation opening that operates automatically and is designed to resist the spread of fire."@en ;
                rdfs:label "FireDamper"@en .


###  https://w3id.org/bam/ficr#FireDamperInstallationStatus
ficr:FireDamperInstallationStatus rdf:type owl:Class ;
                                  rdfs:subClassOf ficr:InstallationStatus ;
                                  rdfs:comment "Installation and specification status of fire dampers within ductwork."@en ;
                                  rdfs:label "FireDamperInstallationStatus"@en .


###  https://w3id.org/bam/ficr#FireDoorset
ficr:FireDoorset rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( ficr:Doorset
                                                            [ rdf:type owl:Class ;
                                                              owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                              owl:onProperty ficr:hasElementUsage ;
                                                                              owl:someValuesFrom ficr:FireResistingRole
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty ficr:hasElementUsage ;
                                                                              owl:someValuesFrom ficr:FireSeparatingRole
                                                                            ]
                                                                          )
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf ficr:FireSafetySystem ;
                 rdfs:comment "A door or shutter which, together with its frame and furniture as installed in a building, is intended (when closed) to resist the spread of fire and/or gaseous products of combustion and meets specified performance criteria to those ends."@en ;
                 rdfs:label "FireDoorset"@en .


###  https://w3id.org/bam/ficr#FireExtinguisher
ficr:FireExtinguisher rdf:type owl:Class ;
                      rdfs:subClassOf ficr:Equipment ;
                      rdfs:comment "A portable or fixed manually-operated device containing an extinguishing agent that can be expelled for the purpose of suppressing or extinguishing a fire. Fire extinguishers are classified by their agent type (water, foam, CO2, dry powder, wet chemical) and by the fire classes they are rated to address."@en ;
                      rdfs:label "FireExtinguisher"@en .


###  https://w3id.org/bam/ficr#FireFightingLift
ficr:FireFightingLift rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ficr:LiftSystem
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty ficr:hasElementUsage ;
                                                                   owl:someValuesFrom ficr:FirefightingRole
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ficr:LiftSystem ;
                      rdfs:comment "A lift with additional protection and with controls that enable it to be used by the fire and rescue service when fighting a fire."@en ;
                      rdfs:label "FireFightingLift"@en .


###  https://w3id.org/bam/ficr#FireHazardSeverity
ficr:FireHazardSeverity rdf:type owl:Class ;
                        rdfs:comment "Fire hazard severity classification: light, moderate, or severe."@en ;
                        rdfs:label "FireHazardSeverity"@en .


###  https://w3id.org/bam/ficr#FireResistingRole
ficr:FireResistingRole rdf:type owl:Class ;
                       rdfs:subClassOf ficr:ElementFireSafetyRole .


###  https://w3id.org/bam/ficr#FireRiskAssessmentTask
ficr:FireRiskAssessmentTask rdf:type owl:Class ;
                            rdfs:subClassOf ficr:Task ;
                            rdfs:comment "A task that estimates insurance-relevant risk metrics such as EML and PML by combining asset exposure, compliance outcomes, and supporting evidence."@en ;
                            rdfs:label "FireRiskAssessmentTask"@en .


###  https://w3id.org/bam/ficr#FireRiskScenario
ficr:FireRiskScenario rdf:type owl:Class ;
                      rdfs:comment "A hypothetical fire scenario anchored to a specific origin space (via hasOriginSpace). It models fire ignition, horizontal and vertical spread pathways, and resulting loss exposure. Each space in the building can serve as the origin of a distinct scenario, and a RiskAssessment evaluates one or more scenarios via hasScenario."@en ;
                      rdfs:label "FireRiskScenario"@en .


###  https://w3id.org/bam/ficr#FireSafetyRole
ficr:FireSafetyRole rdf:type owl:Class ;
                    rdfs:subClassOf ficr:UsageType ;
                    rdfs:comment "Abstract analytical concepts for spatial relationships and paths, not physical entities."@en ;
                    rdfs:label "FireSafetyRole"@en .


###  https://w3id.org/bam/ficr#FireSafetySpace
ficr:FireSafetySpace rdf:type owl:Class ;
                     rdfs:subClassOf bot:Zone ;
                     rdfs:comment "\"Fire safety space\" in a building refers to the areas designed to prevent the spread of fire and smoke and guide occupants to safety."@en ;
                     rdfs:label "FireSafetySpace"@en .


###  https://w3id.org/bam/ficr#FireSafetySystem
ficr:FireSafetySystem rdf:type owl:Class ;
                      rdfs:subClassOf ficr:BuildingSystem ;
                      rdfs:comment "A fire safety system in buildings is a collection of equipment and practices designed to detect, alert occupants of, and control or extinguish fires, thereby protecting lives and property."@en ;
                      rdfs:label "FireSafetySystem"@en .


###  https://w3id.org/bam/ficr#FireSeparatingRole
ficr:FireSeparatingRole rdf:type owl:Class ;
                        rdfs:subClassOf ficr:ElementFireSafetyRole .


###  https://w3id.org/bam/ficr#FireSprinklerSystem
ficr:FireSprinklerSystem rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( ficr:PipingSystem
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty ficr:hasElementUsage ;
                                                                      owl:someValuesFrom ficr:ActiveFireProtectionRole
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf ficr:FireSafetySystem ;
                         rdfs:comment "A fire protection system in a building is a coordinated set of equipment and procedures designed to detect, control, and extinguish fires to safeguard lives and property."@en ;
                         rdfs:label "FireSprinklerSystem"@en .


###  https://w3id.org/bam/ficr#FireStop
ficr:FireStop rdf:type owl:Class ;
              rdfs:subClassOf ficr:FireSafetySystem ;
              rdfs:comment "A seal provided to close an imperfection of fit or design tolerance between elements or components, to restrict the spread of fire and smoke."@en ;
              rdfs:label "FireStop"@en .


###  https://w3id.org/bam/ficr#FirefightingRole
ficr:FirefightingRole rdf:type owl:Class ;
                      rdfs:subClassOf ficr:ElementFireSafetyRole .


###  https://w3id.org/bam/ficr#Flat
ficr:Flat rdf:type owl:Class ;
          rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Floor
ficr:Floor rdf:type owl:Class ;
           rdfs:subClassOf ficr:FabricElement ;
           rdfs:comment "A floor is the horizontal surface in a building that forms the base of a room, providing structural support for occupants, furniture, and the building's own weight."@en ;
           rdfs:label "Floor"@en .


###  https://w3id.org/bam/ficr#FloorSlab
ficr:FloorSlab rdf:type owl:Class ;
               rdfs:subClassOf ficr:Floor ,
                               ficr:Slab ;
               rdfs:comment "A horizontal structural slab forming an intermediate or ground-level floor, transferring occupancy and dead loads to the supporting structure."@en ;
               rdfs:label "FloorSlab"@en .


###  https://w3id.org/bam/ficr#Foyer
ficr:Foyer rdf:type owl:Class ;
           rdfs:subClassOf ficr:CirculationUsage ;
           owl:disjointWith ficr:Hall ,
                            ficr:Lobby .


###  https://w3id.org/bam/ficr#FromUK
ficr:FromUK rdf:type owl:Class ;
            rdfs:subClassOf ficr:RegulatorySource ;
            rdfs:comment "Save relevant knowledge documents from the UK."@en ;
            rdfs:label "FromUK"@en .


###  https://w3id.org/bam/ficr#FuelStorage
ficr:FuelStorage rdf:type owl:Class ;
                 rdfs:subClassOf ficr:PlaceOfSpecialHazard ;
                 owl:disjointWith ficr:SwitchGearRoom ,
                                  ficr:TransformerRoom .


###  https://w3id.org/bam/ficr#Furnishings
ficr:Furnishings rdf:type owl:Class ;
                 rdfs:subClassOf ficr:BuildingContent ;
                 rdfs:comment "Movable items that make a space habitable and decorative."@en ;
                 rdfs:label "Furnishings"@en .


###  https://w3id.org/bam/ficr#Gallery
ficr:Gallery rdf:type owl:Class ;
             rdfs:subClassOf ficr:SpaceUsage ;
             owl:disjointWith ficr:HabitableRoom ,
                              ficr:Kitchen ,
                              ficr:PlaceOfSpecialHazard ,
                              ficr:ServiceUsage ,
                              ficr:Warehouse .


###  https://w3id.org/bam/ficr#GroundAndAboveStorey
ficr:GroundAndAboveStorey rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( bot:Storey
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty ficr:isAboveGround ;
                                                                       owl:hasValue "true"^^xsd:boolean
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf bot:Storey ;
                          rdfs:comment "A storey at or above ground level, defined by isAboveGround = true."@en ;
                          rdfs:label "GroundAndAboveStorey"@en .


###  https://w3id.org/bam/ficr#HVACSystem
ficr:HVACSystem rdf:type owl:Class ;
                rdfs:subClassOf ficr:BuildingSystem ;
                rdfs:comment "An HVAC system is a building's climate control system for heating, ventilation, and air conditioning."@en ;
                rdfs:label "HVACSystem"@en .


###  https://w3id.org/bam/ficr#HabitableRoom
ficr:HabitableRoom rdf:type owl:Class ;
                   rdfs:subClassOf ficr:SpaceUsage ;
                   owl:disjointWith ficr:Kitchen ,
                                    ficr:PlaceOfSpecialHazard ,
                                    ficr:ServiceUsage ,
                                    ficr:Warehouse .


###  https://w3id.org/bam/ficr#Hall
ficr:Hall rdf:type owl:Class ;
          rdfs:subClassOf ficr:CirculationUsage ;
          owl:disjointWith ficr:Lobby .


###  https://w3id.org/bam/ficr#HallOfResidence
ficr:HallOfResidence rdf:type owl:Class ;
                     rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Hospital
ficr:Hospital rdf:type owl:Class ;
              rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Hostel
ficr:Hostel rdf:type owl:Class ;
            rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Hotel
ficr:Hotel rdf:type owl:Class ;
           rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Impaired
ficr:Impaired rdf:type owl:Class ;
              rdfs:subClassOf ficr:ImpairmentState .


###  https://w3id.org/bam/ficr#ImpairmentState
ficr:ImpairmentState rdf:type owl:Class ;
                     rdfs:comment "ImpairmentState of the building component."@en ;
                     rdfs:label "ImpairmentState"@en .


###  https://w3id.org/bam/ficr#ImpairmentUnknown
ficr:ImpairmentUnknown rdf:type owl:Class ;
                       rdfs:subClassOf ficr:ImpairmentState .


###  https://w3id.org/bam/ficr#InnerRoomRole
ficr:InnerRoomRole rdf:type owl:Class ;
                   rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#InstallationStatus
ficr:InstallationStatus rdf:type owl:Class ;
                        rdfs:comment "Whether a fire safety system or component is installed, and if so, to what specification."@en ;
                        rdfs:label "InstallationStatus"@en .


###  https://w3id.org/bam/ficr#Kitchen
ficr:Kitchen rdf:type owl:Class ;
             rdfs:subClassOf ficr:SpaceUsage ;
             owl:disjointWith ficr:PlaceOfSpecialHazard ,
                              ficr:ServiceUsage ,
                              ficr:Warehouse .


###  https://w3id.org/bam/ficr#LiftShaft
ficr:LiftShaft rdf:type owl:Class ;
               rdfs:subClassOf ficr:ShaftSpace ;
               rdfs:comment "A lift shaft is a vertical passageway in a building where an elevator travels between floors."@en ;
               rdfs:label "LiftShaft"@en .


###  https://w3id.org/bam/ficr#LiftSystem
ficr:LiftSystem rdf:type owl:Class ;
                rdfs:subClassOf ficr:VerticalTransportSystem ;
                rdfs:comment "Complete machinery and infrastructure for vertical transport."@en ;
                rdfs:label "LiftSystem"@en .


###  https://w3id.org/bam/ficr#LightHazard
ficr:LightHazard rdf:type owl:Class ;
                 rdfs:subClassOf ficr:FireHazardSeverity .


###  https://w3id.org/bam/ficr#Lobby
ficr:Lobby rdf:type owl:Class ;
           rdfs:subClassOf ficr:CirculationUsage .


###  https://w3id.org/bam/ficr#MeansOfEscapeRole
ficr:MeansOfEscapeRole rdf:type owl:Class ;
                       rdfs:subClassOf ficr:ZoneFireSafetyRole .


###  https://w3id.org/bam/ficr#ModerateHazard
ficr:ModerateHazard rdf:type owl:Class ;
                    rdfs:subClassOf ficr:FireHazardSeverity .


###  https://w3id.org/bam/ficr#MultiStoreyBuilding
ficr:MultiStoreyBuilding rdf:type owl:Class ;
                         rdfs:subClassOf bot:Building ;
                         owl:disjointWith ficr:SingleStoreyBuilding ;
                         rdfs:comment """The building is regarded as a multi-storey building if both of the following apply.
• There is more than one gallery.
• The total aggregate area of all the galleries in one space is more than half the floor area of that space."""@en ;
                         rdfs:label "MultiStoreyBuilding"@en .


###  https://w3id.org/bam/ficr#NonCompliantResult
ficr:NonCompliantResult rdf:type owl:Class ;
                        rdfs:subClassOf ficr:ComplianceResult .


###  https://w3id.org/bam/ficr#ObservedEvidence
ficr:ObservedEvidence rdf:type owl:Class ;
                      rdfs:subClassOf ficr:EvidenceItem ;
                      rdfs:comment "Evidence collected from the building or its digital sensors during inspection or monitoring, such as RGB images, depth, LiDAR/point clouds, and sensor readings. This class represents the content used for assessment, not the provenance metadata standard itself."@en ;
                      rdfs:label "ObservedEvidence"@en .


###  https://w3id.org/bam/ficr#Office
ficr:Office rdf:type owl:Class ;
            rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Opening
ficr:Opening rdf:type owl:Class ;
             rdfs:subClassOf ficr:FabricElement ;
             rdfs:comment "Refers to any intentional void in walls, floors, or ceilings for access, light, air, or services, such as doors, windows, ducts, or stairwells."@en ;
             rdfs:label "Opening"@en .


###  https://w3id.org/bam/ficr#Operational
ficr:Operational rdf:type owl:Class ;
                 rdfs:subClassOf ficr:ImpairmentState .


###  https://w3id.org/bam/ficr#PassiveFireProtectionRole
ficr:PassiveFireProtectionRole rdf:type owl:Class ;
                               rdfs:subClassOf ficr:FireSafetyRole .


###  https://w3id.org/bam/ficr#PerformanceAssertion
ficr:PerformanceAssertion rdf:type owl:Class ;
                          rdfs:comment "A configuration node representing a performance requirement derived from regulatory sources (e.g. ADB, BDM02). Instances such as req_pg1b_wall carry the required REI value for a given purpose group and element type, and serve as the benchmark in SPARQL compliance queries. Actual performance is expressed directly on physical elements via hasREI and similar data properties."@en ;
                          rdfs:label "PerformanceAssertion"@en .


###  https://w3id.org/bam/ficr#PhysicalObject
ficr:PhysicalObject rdf:type owl:Class ;
                    rdfs:comment "Anything that exists in reality and can be located"@en ;
                    rdfs:label "PhysicalObject"@en .


###  https://w3id.org/bam/ficr#PipingSystem
ficr:PipingSystem rdf:type owl:Class ;
                  rdfs:subClassOf ficr:BuildingSystem ;
                  rdfs:comment "Includes pipe fittings and accessories. The definition of ‘pipe’ excludes a flue pipe and a pipe used for ventilating purposes, other than a ventilating pipe for an above-ground drainage system."@en ;
                  rdfs:label "PipingSystem"@en .


###  https://w3id.org/bam/ficr#PlaceOfSpecialHazard
ficr:PlaceOfSpecialHazard rdf:type owl:Class ;
                          rdfs:subClassOf ficr:SpaceUsage ;
                          owl:disjointWith ficr:ServiceUsage ,
                                           ficr:Warehouse .


###  https://w3id.org/bam/ficr#ProtectedCircuit
ficr:ProtectedCircuit rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( ficr:Circuit
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty ficr:hasElementUsage ;
                                                                   owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf ficr:FireSafetySystem ;
                      rdfs:comment "An electrical circuit that is protected against fire."@en ;
                      rdfs:label "ProtectedCircuit"@en .


###  https://w3id.org/bam/ficr#ProtectedCorridor
ficr:ProtectedCorridor rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty ficr:hasZoneFireSafetyRole ;
                                                                    owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty ficr:hasSpaceUsage ;
                                                                    owl:hasValue ficr:Corridor
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf ficr:FireSafetySpace ;
                       owl:disjointWith ficr:ProtectedEntranceHall ,
                                        ficr:ProtectedLobby ,
                                        ficr:ProtectedShaft ,
                                        ficr:ProtectedStairwaySpace ;
                       rdfs:comment "A corridor that is adequately protected from fire in adjoining areas by fire resisting construction."@en ;
                       rdfs:label "ProtectedCorridor"@en .


###  https://w3id.org/bam/ficr#ProtectedEntranceHall
ficr:ProtectedEntranceHall rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty ficr:hasZoneFireSafetyRole ;
                                                                        owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                                      ]
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty ficr:hasSpaceUsage ;
                                                                        owl:hasValue ficr:EntranceHall
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf ficr:FireSafetySpace ;
                           owl:disjointWith ficr:ProtectedLobby ,
                                            ficr:ProtectedShaft ,
                                            ficr:ProtectedStairwaySpace ;
                           rdfs:comment "A circulation area, consisting of a hall or space in a flat, that is enclosed with fire resisting construction other than an external wall of a building."@en ;
                           rdfs:label "ProtectedEntranceHall"@en .


###  https://w3id.org/bam/ficr#ProtectedLobby
ficr:ProtectedLobby rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ficr:hasZoneFireSafetyRole ;
                                                                 owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ficr:hasSpaceUsage ;
                                                                 owl:hasValue ficr:Lobby
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf ficr:FireSafetySpace ;
                    owl:disjointWith ficr:ProtectedShaft ,
                                     ficr:ProtectedStairwaySpace ;
                    rdfs:comment "A corridor or lobby that is adequately protected from fire in adjoining areas by fire resisting construction."@en ;
                    rdfs:label "ProtectedLobby"@en .


###  https://w3id.org/bam/ficr#ProtectedShaft
ficr:ProtectedShaft rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ficr:hasZoneFireSafetyRole ;
                                                                 owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                               ]
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty bot:containsElement ;
                                                                 owl:someValuesFrom ficr:VerticalTransportSystem
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf ficr:FireSafetySpace ;
                    owl:disjointWith ficr:ProtectedStairwaySpace ;
                    rdfs:comment "A shaft that enables people, air or objects to pass from one compartment to another, and which is enclosed with fire resisting construction."@en ;
                    rdfs:label "ProtectedShaft"@en .


###  https://w3id.org/bam/ficr#ProtectedStairway
ficr:ProtectedStairway rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( ficr:Stair
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty ficr:hasElementUsage ;
                                                                    owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf ficr:FireSafetySystem ;
                       rdfs:comment "A stair that leads to a final exit to a place of safety and that is adequately enclosed with fire resisting construction. Included in the definition is any exit passageway between the foot of the stair and the final exit."@en ;
                       rdfs:label "ProtectedStairway"@en .


###  https://w3id.org/bam/ficr#ProtectedStairwaySpace
ficr:ProtectedStairwaySpace rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( bot:Zone
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty ficr:hasZoneFireSafetyRole ;
                                                                         owl:someValuesFrom ficr:PassiveFireProtectionRole
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty bot:containsElement ;
                                                                         owl:someValuesFrom ficr:Stair
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf ficr:FireSafetySpace ;
                            rdfs:comment "A stairway space that leads to a final exit to a place of safety and that is adequately enclosed with fire resisting construction. Included in the definition is any exit passageway between the foot of the stair and the final exit."@en ;
                            rdfs:label "ProtectedStairwaySpace"@en .


###  https://w3id.org/bam/ficr#PurposeGroup
ficr:PurposeGroup rdf:type owl:Class ;
                  rdfs:subClassOf ficr:Classification ;
                  rdfs:comment "Classification of a building or compartment by its intended use according to ADB Table 0.1."@en ;
                  rdfs:label "PurposeGroup"@en .


###  https://w3id.org/bam/ficr#PurposeGroup1
ficr:PurposeGroup1 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup ;
                   rdfs:comment """A dwelling is a unit where one or more people live (whether or not as a sole or main residence) in either of the following situations.
• A single person or people living together as a family.
• A maximum of six people living together as a single household, including where care is provided for residents."""@en ;
                   rdfs:label "PurposeGroup1"@en .


###  https://w3id.org/bam/ficr#PurposeGroup1a
ficr:PurposeGroup1a rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup1 .


###  https://w3id.org/bam/ficr#PurposeGroup1b
ficr:PurposeGroup1b rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup1 .


###  https://w3id.org/bam/ficr#PurposeGroup1c
ficr:PurposeGroup1c rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup1 .


###  https://w3id.org/bam/ficr#PurposeGroup2
ficr:PurposeGroup2 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup ;
                   rdfs:comment "Residential other than Dwellings."@en ;
                   rdfs:label "PurposeGroup2"@en .


###  https://w3id.org/bam/ficr#PurposeGroup2a
ficr:PurposeGroup2a rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup2 .


###  https://w3id.org/bam/ficr#PurposeGroup2b
ficr:PurposeGroup2b rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup2 .


###  https://w3id.org/bam/ficr#PurposeGroup3
ficr:PurposeGroup3 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup .


###  https://w3id.org/bam/ficr#PurposeGroup4
ficr:PurposeGroup4 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup .


###  https://w3id.org/bam/ficr#PurposeGroup5
ficr:PurposeGroup5 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup .


###  https://w3id.org/bam/ficr#PurposeGroup6
ficr:PurposeGroup6 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup .


###  https://w3id.org/bam/ficr#PurposeGroup7
ficr:PurposeGroup7 rdf:type owl:Class ;
                   rdfs:subClassOf ficr:PurposeGroup ;
                   rdfs:comment "Storage and Car Parking"@en ;
                   rdfs:label "PurposeGroup7"@en .


###  https://w3id.org/bam/ficr#PurposeGroup7a
ficr:PurposeGroup7a rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup7 .


###  https://w3id.org/bam/ficr#PurposeGroup7b
ficr:PurposeGroup7b rdf:type owl:Class ;
                    rdfs:subClassOf ficr:PurposeGroup7 .


###  https://w3id.org/bam/ficr#Railing
ficr:Railing rdf:type owl:Class ;
             rdfs:subClassOf ficr:FabricElement ;
             rdfs:comment "A railing refers to a protective barrier or fence, usually made of metal (such as wrought or cast iron, steel, or aluminium), timber, or plastic, designed to provide safety and support."@en ;
             rdfs:label "Railing"@en .


###  https://w3id.org/bam/ficr#RegulatoryRequirement
ficr:RegulatoryRequirement rdf:type owl:Class ;
                           rdfs:subClassOf ficr:PerformanceAssertion ;
                           rdfs:comment "A configuration node recording the minimum performance value mandated by regulation for a specific element type and purpose group. Instances such as req_pg1b_wall carry the required REI for walls in PG1b, linked to their scope via appliesToElementType and appliesToPurposeGroup."@en ;
                           rdfs:label "RegulatoryRequirement"@en .


###  https://w3id.org/bam/ficr#RegulatorySource
ficr:RegulatorySource rdf:type owl:Class ;
                      rdfs:subClassOf ficr:AssessmentBasis ;
                      rdfs:comment "A referenced regulatory or standards document used as the normative basis for a check or requirement, such as Approved Document B, BDM02, or related standards. It provides the requirement context and should be versioned where possible."@en ;
                      rdfs:label "RegulatorySource"@en .


###  https://w3id.org/bam/ficr#RelevantBoundary
ficr:RelevantBoundary rdf:type owl:Class ;
                      rdfs:subClassOf ficr:Boundary ;
                      rdfs:comment "The boundary or notional boundary that one side of the building faces and/or coincides with, and that is parallel or at an angle of a maximum of 80 degrees to that side of the building."@en ;
                      rdfs:label "RelevantBoundary"@en .


###  https://w3id.org/bam/ficr#ResidentialCollege
ficr:ResidentialCollege rdf:type owl:Class ;
                        rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#RiskAnalysis
ficr:RiskAnalysis rdf:type owl:Class ;
                  rdfs:subClassOf ficr:Assessment ;
                  rdfs:comment "A building risk assessment is a systematic process of identifying, evaluating, and managing potential hazards and their associated risks within a building."@en ;
                  rdfs:label "RiskAnalysis"@en .


###  https://w3id.org/bam/ficr#RiskUnit
ficr:RiskUnit rdf:type owl:Class ;
              rdfs:comment "RiskUnit is an exposure value aggregation unit in insurance assessment."@en ;
              rdfs:label "RiskUnit"@en .


###  https://w3id.org/bam/ficr#Roof
ficr:Roof rdf:type owl:Class ;
          rdfs:subClassOf ficr:FabricElement ;
          rdfs:comment "A roof is the top covering of a building that provides protection from the elements like rain, sun, snow, and wind."@en ;
          rdfs:label "Roof"@en .


###  https://w3id.org/bam/ficr#RoofSlab
ficr:RoofSlab rdf:type owl:Class ;
              rdfs:subClassOf ficr:Roof ,
                              ficr:Slab ;
              rdfs:comment "A horizontal structural slab forming the topmost floor of a building, directly supporting the roof covering and transferring loads to walls or columns."@en ;
              rdfs:label "RoofSlab"@en .


###  https://w3id.org/bam/ficr#RoofSpace
ficr:RoofSpace rdf:type owl:Class ;
               rdfs:subClassOf bot:Space ;
               owl:disjointWith ficr:RoomSpace ,
                                ficr:ShaftSpace ,
                                ficr:StairSpace ;
               rdfs:comment "A roof space is the area inside a building between the ceiling of the top floor and the underside of the roof."@en ;
               rdfs:label "RoofSpace"@en .


###  https://w3id.org/bam/ficr#Rooflight
ficr:Rooflight rdf:type owl:Class ;
               rdfs:subClassOf ficr:ElectricalSystem ;
               rdfs:comment "A dome light, lantern light, ridge light."@en ;
               rdfs:label "Rooflight"@en .


###  https://w3id.org/bam/ficr#RooflightOpening
ficr:RooflightOpening rdf:type owl:Class ;
                      rdfs:subClassOf ficr:Closing ;
                      rdfs:comment "A skylight, glazed barrel vault or other element to admit daylight through a roof."@en ;
                      rdfs:label "RooflightOpening"@en .


###  https://w3id.org/bam/ficr#RoomSpace
ficr:RoomSpace rdf:type owl:Class ;
               rdfs:subClassOf bot:Space ;
               owl:disjointWith ficr:ShaftSpace ,
                                ficr:StairSpace ;
               rdfs:comment "An enclosed space within a building that is not used solely as a circulation space. The term includes not only conventional rooms, but also cupboards that are not fittings and large spaces such as warehouses and auditoria. The term does not include cavities such as ducts, ceiling cavities and roof spaces."@en ;
               rdfs:label "RoomSpace"@en .


###  https://w3id.org/bam/ficr#RoutineTriggerEvent
ficr:RoutineTriggerEvent rdf:type owl:Class ;
                         rdfs:subClassOf ficr:Event ;
                         rdfs:comment "A trigger event generated from routine schedules or planned inspection cycles derived from FiCR maintenance and regulatory schedules, such as monthly fire exit checks."@en ;
                         rdfs:label "RoutineTriggerEvent"@en .


###  https://w3id.org/bam/ficr#School
ficr:School rdf:type owl:Class ;
            rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#SelfClosingDevice
ficr:SelfClosingDevice rdf:type owl:Class ;
                       rdfs:subClassOf ficr:Closing ;
                       rdfs:comment """A device that closes a door, when open at any angle, against a door frame.
NOTE: If the door is in a cavity barrier, rising butt hinges (which are different from the self-closing device mentioned above) are acceptable."""@en ;
                       rdfs:label "SelfClosingDevice"@en .


###  https://w3id.org/bam/ficr#Sensor
ficr:Sensor rdf:type owl:Class ;
            rdfs:subClassOf ficr:Equipment ;
            rdfs:comment "A sensor in a building is a device that detects environmental changes and sends data to a control system to manage building functions like lighting, HVAC, and safety."@en ;
            rdfs:label "Sensor"@en .


###  https://w3id.org/bam/ficr#ServiceShaft
ficr:ServiceShaft rdf:type owl:Class ;
                  rdfs:subClassOf ficr:ShaftSpace ;
                  rdfs:comment "A service shaft is a vertical passage in a building that houses pipes, cables, and ducts for essential building systems like water, electricity, and ventilation."@en ;
                  rdfs:label "ServiceShaft"@en .


###  https://w3id.org/bam/ficr#ServiceUsage
ficr:ServiceUsage rdf:type owl:Class ;
                  rdfs:subClassOf ficr:SpaceUsage ;
                  owl:disjointWith ficr:Warehouse .


###  https://w3id.org/bam/ficr#SevereHazard
ficr:SevereHazard rdf:type owl:Class ;
                  rdfs:subClassOf ficr:FireHazardSeverity .


###  https://w3id.org/bam/ficr#ShaftSpace
ficr:ShaftSpace rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( bot:Space
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty bot:containsElement ;
                                                             owl:someValuesFrom ficr:VerticalTransportSystem
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf bot:Space ;
                owl:disjointWith ficr:StairSpace ;
                rdfs:comment "A smaller, enclosed vertical space extending through multiple floors used for specific building services, such as elevator hoistways, enclosed stairwells, or ducts for plumbing, electrical, or air-conditioning equipment."@en ;
                rdfs:label "ShaftSpace"@en .


###  https://w3id.org/bam/ficr#ShelteredHousing
ficr:ShelteredHousing rdf:type owl:Class ;
                      rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#Shop
ficr:Shop rdf:type owl:Class ;
          rdfs:subClassOf ficr:UtilizationPurpose .


###  https://w3id.org/bam/ficr#SingleStoreyBuilding
ficr:SingleStoreyBuilding rdf:type owl:Class ;
                          rdfs:subClassOf bot:Building ;
                          rdfs:comment "A building that consists of a ground storey only. Basements are not counted as storeys in a building (see Appendix D). A separated part that consists of a ground storey only, with a roof to which access is only provided for repair or maintenance, may be treated as a single storey building."@en ;
                          rdfs:label "SingleStoreyBuilding"@en .


###  https://w3id.org/bam/ficr#Slab
ficr:Slab rdf:type owl:Class ;
          rdfs:subClassOf ficr:StructuralElement ;
          rdfs:comment "A slab is the thick, structural concrete element (like reinforced concrete) forming a building's horizontal plane"@en ;
          rdfs:label "Slab"@en .


###  https://w3id.org/bam/ficr#SolarShadingDevice
ficr:SolarShadingDevice rdf:type owl:Class ;
                        rdfs:subClassOf ficr:SpecifiedAttachment ;
                        rdfs:comment "A device attached to the external surface of an external wall for reducing heat gain within a building by shading or deflecting sunlight."@en ;
                        rdfs:label "SolarShadingDevice"@en .


###  https://w3id.org/bam/ficr#SpaceUsage
ficr:SpaceUsage rdf:type owl:Class ;
                rdfs:subClassOf ficr:UsageType ;
                rdfs:comment "Describe the uses of the space."@en ;
                rdfs:label "SpaceUsage"@en .


###  https://w3id.org/bam/ficr#SpecifiedAttachment
ficr:SpecifiedAttachment rdf:type owl:Class ;
                         rdfs:subClassOf ficr:FabricElement ;
                         rdfs:comment """Includes any of the following.
• A balcony attached to an external wall.
• A device for reducing heat gain within a building by deflecting sunlight which is attached to an external wall."""@en ;
                         rdfs:label "SpecifiedAttachment"@en .


###  https://w3id.org/bam/ficr#SprinklerStatus
ficr:SprinklerStatus rdf:type owl:Class ;
                     rdfs:subClassOf ficr:InstallationStatus ;
                     rdfs:comment "Installation status indicating whether an automatic sprinkler system is installed and to what specification."@en ;
                     rdfs:label "SprinklerStatus"@en .


###  https://w3id.org/bam/ficr#Stair
ficr:Stair rdf:type owl:Class ;
           rdfs:subClassOf ficr:FabricElement ;
           rdfs:comment "a stairway (or staircase) is a series of steps connecting different levels in a building, serving as a pedestrian route."@en ;
           rdfs:label "Stair"@en .


###  https://w3id.org/bam/ficr#StairFlight
ficr:StairFlight rdf:type owl:Class ;
                 rdfs:subClassOf ficr:FabricElement ;
                 rdfs:comment "A stair flight (or simply \"flight\") refers to an uninterrupted, continuous sequence of stairs (steps/risers) that connect two levels, floors, or intermediate landings."@en ;
                 rdfs:label "StairFlight"@en .


###  https://w3id.org/bam/ficr#StairSpace
ficr:StairSpace rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( bot:Space
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty bot:containsElement ;
                                                             owl:someValuesFrom ficr:Stair
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf bot:Space ;
                rdfs:comment "A stairway space, also called a stairwell, is the vertical compartment in a building that contains a flight of stairs and the associated landings, hallways, or other areas needed to move between floors."@en ;
                rdfs:label "StairSpace"@en .


###  https://w3id.org/bam/ficr#Storage
ficr:Storage rdf:type owl:Class ;
             rdfs:subClassOf ficr:UtilizationPurpose .


